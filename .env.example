# Copy to .env.local for local development. Never commit real values.
# Set the same variables per environment in your host (Production, Preview).

# --- Public settings (used at build time to render pages) -------------------

# Which product this deployment sells: chore-audit or anime-starter-pack.
# One product per deployment. Leave unset for chore-audit.
PRODUCT=chore-audit

# Canonical origin of this deployment. https required except on localhost.
APP_URL=http://localhost:3000

# Price in the smallest currency unit, and its currency (usd, eur, gbp, cad, aud).
# If unset, the product's own default applies (chore-audit 1900,
# anime-starter-pack 900).
PRICE_CENTS=1900
PRICE_CURRENCY=usd

# The delivery promise shown to buyers (YYYY-MM-DD). Pre-orders close
# automatically after this date. Choose a date you can keep.
SHIP_BY_DATE=

# Kill switch. Set to false and redeploy to stop taking pre-orders.
PREORDERS_OPEN=true

# Shown on the site and in the terms.
SUPPORT_EMAIL=
LEGAL_ENTITY_NAME=

# Set to true only after Stripe Tax is configured in the Stripe account.
STRIPE_AUTOMATIC_TAX=false

# --- Secrets (read at request time; never exposed to the browser) -----------

# Use a restricted key (rk_...) in production if you can: it needs write access
# to Checkout Sessions and nothing else.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
